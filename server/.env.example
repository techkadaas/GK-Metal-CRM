# =================================================================
# GK METAL TESTING LAB - BACKEND CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values for your environment
# =================================================================

# Server Port (Default: 5000)
PORT=5000

# Environment Mode ('development' | 'production')
NODE_ENV=production

# MongoDB Connection String (Leave empty for fallback file store)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority

# Secret key used for signing JSON Web Tokens
JWT_SECRET=your_strong_random_secret_jwt_key_here

# Token Expiry (e.g. 1d, 7d, 30d)
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (e.g. http://localhost:5173 or https://yourdomain.com)
CORS_ORIGIN=*
